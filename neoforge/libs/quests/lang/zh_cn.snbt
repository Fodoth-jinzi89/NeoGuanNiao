		"{\"text\":\"一个专门的\",\"extra\":[{\"text\":\"火箭材料\",\"color\": \"light_purple\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1A2525C5B78A9496\"},\"underlined\":true},\"页面会介绍它。\"]}"
