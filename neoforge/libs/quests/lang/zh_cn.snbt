	quest.0EFCFC8EE2B3112C.quest_subtitle: "3 阶"
	quest.0EFCFC8EE2B3112C.title: "谐振水晶"
	quest.0F163D3E3B48D52C.quest_desc: [
		"&6AE2 QoL Cilent &r为&a合成终端&r添加了一些&a快捷键&r。"
		""
		"&e鼠标悬停&r在&6 EMI&r 的&a物品&r上时："
		"&a鼠标中键&r 以&b请求一个&r；"
		"&aShift + 鼠标中键&r 以&b请求至多一组&r；"
		"&aCtrl + 鼠标左键&r 以&b快速合成一个（仅合成配方且原料充足）&r。"
		"&aCtrl + 鼠标中键&r 以&b打开下单界面&r。"
		"&aF &r键以&b在 AE 中搜索之&r；"
		"&aC &r键以&b清空搜索&r；"
		""
		"现在&a样板编码终端&r会&e自动补充空白样板&r。"
		""
		"&a纸&r是默认的&b伪合成标记物&r，如果一个 &6EMI &r配方&c没有默认输出&r，则&a纸&r会作为&b伪合成输出&r。"
	]
	quest.0F163D3E3B48D52C.quest_subtitle: "来自模组 AE2 Qol Client"
	quest.0F163D3E3B48D52C.title: "终端快捷键"
	quest.0F5E844B011B0850.quest_desc: ["也可以通入&a灌溉塔&r浇灌你的田地。"]
	quest.0F5E844B011B0850.title: "序列组装"
	quest.0F8B560BA4FDD1BD.quest_desc: ["要烤面包一定要有烤炉！查看生面包胚上显示的烘烤温度并将烤炉调整到对应的温度，放入面包胚，等待美味的面包出炉吧。"]
	quest.0F8B560BA4FDD1BD.quest_subtitle: "精准控温"
	quest.0F8D45B67C69918C.quest_desc: [
		"将它放在地上，和&a女仆&r一起骑乘，就能&e畅快飞行&r啦！"
		""
