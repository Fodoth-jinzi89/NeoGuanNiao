	quest.247A00FC0060B26C.quest_subtitle: "电视"
	quest.247A00FC0060B26C.title: "播放监控"
	quest.248786940A769E27.quest_desc: [
		"发电量略低，合成较容易，消耗材料少，但需要一些珍稀材料。"
		""
		"可以安装至多 &a4&r 个&e太阳能升级&r，进一步提升发电。"
