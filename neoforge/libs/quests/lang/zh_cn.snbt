	quest.31CCB131D95574E7.title: "神秘学生物"
	quest.31DE7F0D29DD1F7F.title: "蒸发"
	quest.31EB9B14418D1A62.quest_desc: ["需要&a山羊角&r和&a唱片&r制作。"]
	quest.31EB9B14418D1A62.quest_subtitle: "旋律"
	quest.3209399B68BC6BCD.quest_desc: [
		"通过&b合成&r获取。"
		""
		"&a锁藏之书&r终于有用了！"
