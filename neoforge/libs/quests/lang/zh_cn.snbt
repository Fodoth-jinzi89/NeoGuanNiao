	quest.24238359015CC7B8.quest_subtitle: "风暴女皇"
	quest.24238359015CC7B8.title: "斯库拉"
	quest.242EC97CEFC0835C.quest_desc: [
		"使用它可以播放&a网络媒体&r。"
		""
		"仅支持&b直链 mp4&r，像&b B 站&r这样的&e流媒体视频无法播放&r。"
