	quest.3EDD4A291D46C204.quest_subtitle: "活化工具台"
	quest.3EDD4A291D46C204.title: "自动执行器"
	quest.3EEE36BEBBD6A0E3.quest_desc: [
		"完成对应燃料产线后可以考虑建造&b无限流体池&r来抽取&e燃料&r。"
		""
