	quest.74BD8B7216DDBC26.quest_desc: [
		"&6难度：&r⭐"
		""
		"&6生命：&r&a9000"
		"&r&6护甲：&r&a250"
		"&r&6韧性：&r&a30&r"
		""
		"可能是&a最简单&r的一个 BOSS 。"
		""
		"用&a沙漠项链&r来唤醒它。"
		""
		"记得先&b清理周围的小怪&r！"
		"{@pagebreak}"
