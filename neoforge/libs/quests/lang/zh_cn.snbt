	quest.142D1A36520E1F3A.title: "打蛋机"
	quest.14619B739950006B.quest_desc: ["用这些&a道具&r可以召唤&b毛孩子们&r。"]
	quest.14619B739950006B.quest_subtitle: "你是猫猫派还是狗狗派？"
