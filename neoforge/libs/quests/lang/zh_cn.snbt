	quest.140667396DC863D9.quest_subtitle: "可控燃烧室"
	quest.140667396DC863D9.title: "替代方案"
	quest.142D1A36520E1F3A.quest_desc: [
		"将&a鸡蛋&r右键放入，再次右键启动，会将其分为&a蛋液&r和&a蛋壳&r。"
		""
