		"{\"text\":\"它有一个\",\"extra\":[{\"text\":\"专有页面\",\"color\": \"light_purple\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"56D91D3F1A7AD5FF\"},\"underlined\":true},\"可供参考。\"]}"
