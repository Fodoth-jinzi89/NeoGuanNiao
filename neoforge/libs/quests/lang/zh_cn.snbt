	quest.15E406E8D1052D74.quest_subtitle: "紧致单格"
	quest.15E406E8D1052D74.title: "鼓风机触媒"
	quest.15EDD0D2497AC531.quest_desc: [
		"该模组更改了&e近战武器&r的战斗方式，&a长按左键&r即可连续挥击。"
		""
