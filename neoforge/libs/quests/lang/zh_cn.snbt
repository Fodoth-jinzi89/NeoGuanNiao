	quest.7202C5D8D2E4377F.title: "压缩"
	quest.720FE53A6C47755E.quest_desc: [
		"盛景的厨具&b不消耗耐久&r，很适合&e自动合成&r。"
		""
		"最没用的&a研钵&r，没有之一。"
