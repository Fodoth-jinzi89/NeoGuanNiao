	quest.0EBAF05C2EA03053.quest_subtitle: "锁住的秘密"
	quest.0EED45F9B8B6390D.quest_desc: ["喂给幼鸟以&a停止/恢复生长&r，和&b金蒲公英&r作用类似。"]
