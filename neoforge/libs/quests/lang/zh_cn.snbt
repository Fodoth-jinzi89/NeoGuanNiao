	quest.2600B735B94B0004.title: "溶解"
	quest.2606745E943521BD.quest_desc: [
		"在下界会生成一些含有大量&a硫磺&r的生物群系。"
		""
		"你可以将这些&a硫磺石&r粉碎得到&a硫粉&r，用于制作&e硫酸&r！"
		""
		"什么？你说&e硫方怪&r？它还在遥远的未来等着我们呢！"
	]
	quest.2606745E943521BD.quest_subtitle: "庆祝 26.2 更新"
	quest.2606745E943521BD.title: "硫磺地狱"
	quest.261179C0788DE84E.quest_desc: [
		"&6难度：&r⭐⭐⭐⭐⭐⭐⭐"
		""
		"&6生命：&r&a360000"
		"&r&6护甲：&r&a1212"
		"&r&6韧性：&r&a100&r"
		""
		"用&a下界之星&r右键召唤。"
		""
		"&z近乎无敌&r的存在，就连&a MekaSuit &r都扛不住它的&c激光&r。"
		""
		"如果想要用&a无常索命&r斩杀它，可以将它引到&b狭小的空间&r中。"
