	quest.4CF99FCE01A15CE1.quest_desc: [
		"&o&7玩神化，得无敌装备！"
		"&r"
		"&r&6神化&r是一款关于&a词条&r、&a附魔&r、&a宝石镶嵌&r、&a刷怪&r和&a药水护符&r的模组，是&e强化装备&r的不二之选。"
		""
		"&aCtrl + T &r打开神化的&e世界层级&r页面，可以调整&a独立难度&r和&a怪物掉落&r。"
	]
	quest.4CF99FCE01A15CE1.quest_subtitle: "Apotheosis"
	quest.4CF99FCE01A15CE1.title: "神化"
	quest.4D1A5950780CBE00.quest_desc: [
		"你需要这&a四种方块&r帮你聚合晶种。"
		""
		"鉴于需要的量很大，用一个带&a堆叠升级&r的&e绝对&r以上&b粉碎工厂&r是个好主意。"
		""
		"另一个&b粉碎工厂（不开均分）&r用于粉碎&a高纯水晶&r。"
	]
	quest.4D1A5950780CBE00.quest_subtitle: "圆石、沙砾、沙子、末地石"
	quest.4D1A5950780CBE00.title: "晶种材料"
	quest.4D4344AB2E4536B3.quest_desc: ["这里提供一种在基地里即可量产钻石的方法。"]
	quest.4D4344AB2E4536B3.quest_subtitle: "来自树场"
	quest.4D4344AB2E4536B3.title: "木炭"
	quest.4D6B5BD239822086.quest_desc: [
		"用来制作各种&a饮品&r。"
		""
