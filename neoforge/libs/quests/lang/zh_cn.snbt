	quest.56D0C7BA1510C116.title: "催熟"
	quest.56D2FCA02EEA0BB6.quest_desc: ["如果你完成了&d圆石生万物&r的&a深板岩&r产线，可以考虑用 &6Mek 融合机&r合成&a深层煤矿石&r来增加产量。"]
	quest.56D2FCA02EEA0BB6.title: "压缩"
	quest.572298318A0A18C1.quest_desc: [
