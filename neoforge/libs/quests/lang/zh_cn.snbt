	]
	quest.0CD802CF87E35AC4.quest_subtitle: "味极鲜"
	quest.0CD802CF87E35AC4.title: "调味大师"
	quest.0CE60BF6AABD1064.quest_desc: [
		"机器还可以安装一些&e升级插件&r。比较常用的有："
		""
		"&a速度升级&r：提升速度，但增加能量消耗。"
		"&a能量升级&r：减少能量消耗。"
		"&a化学品升级&r：减少化学品消耗。"
		"&a降噪升级&r：减少噪音。"
		""
		"&6Mekanism Unleashed &r模组使得你最多可以安装&a 32 &r个速度/能量升级！"
		""
		"不过一般各&a 8 &r个也就够用了，后期可以用 &a12/16 &r个。"
		""
		"&b只装速度不装能量&r可能会&c瞬间吸干家里的电&r！"
		""
		"你需要一台&a粉碎机&r来获取做这些升级的粉。"
	]
	quest.0CE60BF6AABD1064.quest_subtitle: "机器升级"
	quest.0CE60BF6AABD1064.title: "加速超频"
	quest.0D46A5DD68809257.quest_desc: ["在&a工作台&r制作。"]
	quest.0D46A5DD68809257.quest_subtitle: "深渊"
