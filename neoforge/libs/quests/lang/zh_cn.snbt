	quest.2CE3FC6F4E764A83.title: "钻入地心"
	quest.2D4A7DA7CF85AC54.quest_desc: [
		"&a焰魔&r的栖居之所，虽然已经废弃多年，但其间的烈焰从未熄灭。"
		""
