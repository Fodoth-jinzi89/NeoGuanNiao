	quest.3A87FBCA4BFF0FF4.quest_subtitle: "需要工匠卷轴"
	quest.3A87FBCA4BFF0FF4.title: "铭刻符文之戒"
	quest.3A8CD3762C96BF7B.quest_desc: [
