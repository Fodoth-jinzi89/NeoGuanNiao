	quest.4EE2C006741996B3.quest_desc: ["&#FFCE3C杂&r&e种&r，&e本&r&#FFCE3C王&r&4赏&r&#FFCE3C赐&r&e你&r&4我&r&e武器&r的&#FFCE3C周边&r&e创作&r权&#FFCE3C，赞&r颂&e我&#FFCE3C吧&r"]
