	quest.261179C0788DE84E.title: "先驱者"
	quest.26541B201E995500.quest_desc: ["这个模组的矿物简单烧制或合成即可。"]
	quest.26541B201E995500.quest_subtitle: "简单处理"
	quest.26541B201E995500.title: "Hazen 的矿"
	quest.26860BB8E22C14B0.quest_desc: [
		"用&a存储总线&r贴着&a存储控制器&r以连接&b精致存储&r。"
		""
		"通常会设为&6仅取出&r模式，以连接&b带销毁的自动化产线&r。"
