	quest.438E0AB8FDDE9F25.quest_desc: ["生成于&b末地外岛&r的建筑，一共分为4层，这里是&a末影守卫&r的迷宫堡垒。"]
	quest.438E0AB8FDDE9F25.quest_subtitle: "虚空之城"
	quest.438E0AB8FDDE9F25.title: "废弃堡垒"
	quest.43909CB3691B257D.quest_desc: [
		"&a右键&r放置在地上，&a右键最底层的蒸笼&r堆叠，最多堆叠&a 16 &r层，&b疾跑状态下可一键堆叠&r。"
		""
		"之后放入&e待蒸煮的食材&r，每个蒸笼需要&a 4&r 个食材。"
		""
		"&a空手右键&r最底层，蒸笼们会检查内部的存储，进行打包。空蒸笼会返还。"
		""
		"打包好的蒸笼可以&b右键收取并重新放置&r。"
		""
		"之后用足量的&a纯净水&r右键&b底部&r，开始蒸煮。"
		""
		"听到&b切石机声音&r，蒸煮就完成了，&a右键&r收取&e全部的蒸笼和蒸好的美食&r！"
		""
		"蒸笼的行为是&6 GoldenTweaks &r调整的。"
	]
	quest.43909CB3691B257D.quest_subtitle: "面食大师"
	quest.43945C2E23D2A231.quest_desc: ["击杀&a紫水晶巨蟹&r掉落。"]
