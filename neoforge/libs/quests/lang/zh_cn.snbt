	]
	quest.6B523F4647E87C93.quest_subtitle: "来自模组 Silent Gear"
	quest.6B523F4647E87C93.title: "更好的工具"
	quest.6B55B2D7D7628E7A.quest_desc: ["对成鸟使用，使之&a回退到幼鸟状态&r，并重置生长时间。"]
	quest.6B55B2D7D7628E7A.quest_subtitle: "返老还童"
	quest.6B55B2D7D7628E7A.title: "复原"
	quest.6B610A494A759959.quest_desc: [
		"作为一个负责&e家园建设&r的玩家，下一步你可能要搞的就是&6发电&r了。毕竟 &6Mek&r 和 &6AE &r都需要电，电还可以通过&a电动马达&r方便地转化为&e应力&r。"
		""
		"你可以用&6机械动力&r的附属发电，不过最好还是使用&6 Mekanism&r！"
		""
		"提交一个填满的&a能量板&r来完成这个任务。"
	]
	quest.6B610A494A759959.quest_subtitle: "土豆电池！"
	quest.6B610A494A759959.title: "如何发电"
	quest.6B7992E5B2367220.quest_desc: [
		"记得填充完整你的&e颜料储备&r！"
		""
		"现在&a 16 &r种树苗都可以制作了。"
