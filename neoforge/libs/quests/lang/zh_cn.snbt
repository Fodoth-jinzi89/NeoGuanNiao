		"{\"text\":\"\",\"extra\":[{\"text\":\"氧\",\"color\":\"green\"},\"则是通入\",{\"text\":\"提纯仓\",\"color\":\"yellow\"},\"供给\",{\"text\":\"2 倍矿产线\",\"color\": \"light_purple\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"70E45F23C78AD1A8\"},\"underlined\":true},\"。\"]}"
