	quest.23A1F3E8445F1F77.quest_subtitle: "魂灵"
	quest.23BD660D0510A197.quest_desc: ["沐浴&a圣洁&r光辉的魔宠，能够&b治疗&r和&b增强&r友方，偶尔会召唤名为&b泰拉棱镜&r的圣剑协助作战。"]
	quest.23BD660D0510A197.quest_subtitle: "神圣"
	quest.23BD660D0510A197.title: "牧师"
