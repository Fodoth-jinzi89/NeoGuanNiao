	quest.3EBC024596E92681.quest_subtitle: "各种法术书"
	quest.3EBC024596E92681.title: "法术书"
	quest.3EC9AFE93AFD1871.quest_desc: [
		"&6神化&r模组提供了&e附魔台&r和&e铁砧&r的改进，现在附魔和铁砧只需要消耗&b相当于玩家在该等级操作&r时的经验。"
		""
		"举个例子，玩家&a 60&r 级，进行一次 &a30 &r级消耗 &a3 &r级的附魔，不会像原版一样变为 &a57 &r级，而是 &a58~59&r 级。"
		""
		"也就是说铁砧和附魔台&6不会浪费经验&r了！"
	]
	quest.3EC9AFE93AFD1871.quest_subtitle: "附魔台和铁砧改进"
	quest.3EC9AFE93AFD1871.title: "神化附魔"
	quest.3ECB85FC7E31C12A.quest_desc: ["送你一个我的人偶"]
	quest.3ECB85FC7E31C12A.title: "XXX留下的神话研究"
	quest.3EDD4A291D46C204.quest_desc: [
